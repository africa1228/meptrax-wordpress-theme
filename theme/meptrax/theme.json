{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "navy", "color": "#001F3F", "name": "Navy" },
        { "slug": "navy-light", "color": "#0a2d52", "name": "Navy Light" },
        { "slug": "orange", "color": "#FF9F00", "name": "Orange" },
        { "slug": "orange-dark", "color": "#e68a00", "name": "Orange Dark" },
        { "slug": "sky", "color": "#dbeafe", "name": "Sky" },
        { "slug": "sky-dark", "color": "#93c5fd", "name": "Sky Dark" },
        { "slug": "white", "color": "#ffffff", "name": "White" },
        { "slug": "gray-100", "color": "#f8fafc", "name": "Gray 100" },
        { "slug": "gray-500", "color": "#64748b", "name": "Gray 500" },
        { "slug": "gray-900", "color": "#0f172a", "name": "Gray 900" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "1" },
        { "slug": "30", "size": "1rem", "name": "2" },
        { "slug": "40", "size": "1.5rem", "name": "3" },
        { "slug": "50", "size": "2rem", "name": "4" },
        { "slug": "60", "size": "3rem", "name": "5" },
        { "slug": "70", "size": "4rem", "name": "6" },
        { "slug": "80", "size": "5rem", "name": "7" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"Inter\", \"Segoe UI\", -apple-system, BlinkMacSystemFont, Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
          "slug": "inter",
          "name": "Inter"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.125rem", "name": "Large" },
        { "slug": "x-large", "size": "1.35rem", "name": "Extra Large" },
        { "slug": "xx-large", "size": "2rem", "name": "2X Large" },
        { "slug": "hero", "size": "clamp(2.1rem, 4.5vw, 3.25rem)", "name": "Hero" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--gray-900)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--navy)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--orange)" }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": { "text": "var(--wp--preset--color--navy)" }
      },
      "button": {
        "border": { "radius": "8px" },
        "typography": { "fontWeight": "600" },
        "spacing": {
          "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" }
        },
        "color": {
          "background": "var(--wp--preset--color--orange)",
          "text": "var(--wp--preset--color--white)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--orange-dark)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "1.35rem",
          "fontWeight": "800",
          "letterSpacing": "0.02em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": { "color": { "text": "var(--wp--preset--color--navy)" } }
        }
      },
      "core/site-tagline": {
        "typography": {
          "fontSize": "0.65rem",
          "fontWeight": "600",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        },
        "color": { "text": "var(--wp--preset--color--gray-500)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-legal", "title": "Legal Page", "postTypes": ["page"] }
  ]
}
