{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "navy", "color": "#0f172a", "name": "Navy" },
        { "slug": "navy-light", "color": "#1e293b", "name": "Navy Light" },
        { "slug": "amber", "color": "#f59e0b", "name": "Amber" },
        { "slug": "amber-dark", "color": "#d97706", "name": "Amber Dark" },
        { "slug": "white", "color": "#ffffff", "name": "White" },
        { "slug": "gray-100", "color": "#f1f5f9", "name": "Gray 100" },
        { "slug": "gray-600", "color": "#475569", "name": "Gray 600" },
        { "slug": "gray-900", "color": "#0f172a", "name": "Gray 900" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1100px"
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "1" },
        { "slug": "30", "size": "1rem", "name": "2" },
        { "slug": "40", "size": "1.5rem", "name": "3" },
        { "slug": "50", "size": "2rem", "name": "4" },
        { "slug": "60", "size": "3rem", "name": "5" },
        { "slug": "70", "size": "4rem", "name": "6" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
          "slug": "system",
          "name": "System"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "1.5rem", "name": "Extra Large" },
        { "slug": "xx-large", "size": "2.25rem", "name": "2X Large" },
        { "slug": "hero", "size": "clamp(2rem, 5vw, 3rem)", "name": "Hero" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--gray-900)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--amber-dark)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--amber)" }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.25"
        },
        "color": { "text": "var(--wp--preset--color--navy)" }
      },
      "button": {
        "border": { "radius": "6px" },
        "color": {
          "background": "var(--wp--preset--color--amber)",
          "text": "var(--wp--preset--color--navy)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--amber-dark)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontSize": "var(--wp--preset--font-size--large)" },
        "elements": {
          "link": { "color": { "text": "var(--wp--preset--color--white)" } }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-legal", "title": "Legal Page", "postTypes": ["page"] }
  ]
}
